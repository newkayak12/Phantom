<!-- Optional: loads only where the Java plugin is installed; without it .java files keep the generic Java icon from phantom.icons.core. -->
<idea-plugin package="dev.phantom.icons.java">
  <dependencies>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.psi.impl"/>
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <!-- after the core provider, which answers for files and folders only; any provider's answer replaces the class icon
         that PsiClassImpl computes when no provider answers -->
    <iconProvider implementation="dev.phantom.icons.java.JavaKindIconProvider" order="after phantomMaterial"/>
  </extensions>
</idea-plugin>

<idea-plugin package="dev.phantom.icons.core">
  <extensions defaultExtensionNs="com.intellij">
    <fileIconProvider implementation="dev.phantom.icons.core.MaterialFileIconProvider" order="first"/>
    <iconProvider implementation="dev.phantom.icons.core.MaterialPsiIconProvider" order="first"/>
    <!-- first: before the language navbar extensions return the class icon -->
    <navbar implementation="dev.phantom.icons.core.KotlinFileNavBarIcon" order="first"/>
    <!-- last: after the Kotlin plugin has set the class icon -->
    <projectViewNodeDecorator implementation="dev.phantom.icons.core.KotlinFileNodeDecorator" order="last"/>
  </extensions>
</idea-plugin>

<idea-plugin package="dev.phantom.jpa.core">
  <dependencies>
    <plugin id="com.intellij.java"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.indexing"/>
    <module name="intellij.java"/>
    <module name="intellij.platform.uast"/>
  </dependencies>
  <resource-bundle>messages.PhantomJpaBundle</resource-bundle>
  <extensions defaultExtensionNs="com.intellij">
    <fileType name="JPQL" language="JPQL" implementationClass="dev.phantom.jpa.core.JpqlFileType" fieldName="INSTANCE"/>
    <lang.parserDefinition language="JPQL" implementationClass="dev.phantom.jpa.core.JpqlParserDefinition"/>
    <lang.syntaxHighlighterFactory language="JPQL" implementationClass="dev.phantom.jpa.core.JpqlSyntaxHighlighterFactory"/>
    <lang.braceMatcher language="JPQL" implementationClass="dev.phantom.jpa.core.JpqlBraceMatcher"/>
    <annotator language="JPQL" implementationClass="dev.phantom.jpa.core.JpqlAnnotator"/>
    <multiHostInjector implementation="dev.phantom.jpa.core.JpqlQueryInjector"/>
    <localInspection language="UAST" enabledByDefault="true" level="ERROR" shortName="PhantomDerivedQuery"
                     bundle="messages.PhantomJpaBundle" key="derived.inspection.display.name"
                     groupBundle="messages.PhantomJpaBundle" groupKey="inspection.group.name"
                     implementationClass="dev.phantom.jpa.core.DerivedQueryInspection"/>
    <completion.contributor language="JAVA" order="first" implementationClass="dev.phantom.jpa.core.DerivedQueryCompletionContributor"/>
    <completion.contributor language="kotlin" order="first" implementationClass="dev.phantom.jpa.core.DerivedQueryCompletionContributor"/>
  </extensions>
</idea-plugin>

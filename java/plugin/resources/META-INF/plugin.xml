    <module name="intellij.java.duplicates"/>
    <module name="intellij.java.duplicates.analysis"/>
    <module name="intellij.java.duplicatesDetection"/>
    <module name="intellij.java.jam.impl"/>
    <module name="intellij.java.jam"/>
    <module name="intellij.profiler.ultimate"/>
    <module name="intellij.debugger.jvm.advanced.java"/>
    <module name="intellij.debugger.logpoints.shared"/>
    <module name="intellij.debugger.logpoints.backend"/>
    <module name="intellij.debugger.logpoints.frontend"/>
    <module name="intellij.debugger.logpoints.frontend.split"/>
    <module name="intellij.debugger.jvm.advanced.java.logpoints"/>
    <module name="intellij.debugger.logpoints.java"/>
    <module name="intellij.java.copyright"/>
    <!-- phantom-idea: removed the intellij.java.promo content module (Ultimate promotion, a locked Spring wizard entry) -->
  </content>
  <content>
    <module name="intellij.libraries.test.discovery" loading="embedded"/>
  </content>
</idea-plugin>
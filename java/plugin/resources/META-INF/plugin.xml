    <module name="intellij.java.manifest" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.ui" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.execution.impl"/>
    <module name="intellij.java.debugger.impl"/>
    <module name="intellij.java.debugger.memory.agent" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.remoteServers.impl" loading="optional"/>

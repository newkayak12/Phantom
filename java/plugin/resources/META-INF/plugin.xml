<idea-plugin allow-bundled-update="true">
  <!-- phantom-idea: published as a separate plugin, not bundled; com.intellij.java stays as an alias for dependents -->
  <id>dev.phantom.java</id>
  <name>Support for Java</name>
  <description><![CDATA[
    Adds support for the Java language, including Java projects, language syntax highlighting, inspections, and all other coding assistance features.
  ]]></description>

  <!-- phantom-idea: Phantom modified this plugin, so Phantom (not JetBrains) is its vendor -->
  <vendor url="https://github.com/newkayak12/Phantom">Phantom</vendor>
  <category>Languages</category>
  <resource-bundle>messages.ActionsBundle</resource-bundle>

  <!--other dependencies inside java.backend plugin-->
  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
  </dependencies>

  <module value="com.intellij.modules.java"/>
  <!-- phantom-idea: the old plugin id and the capability the IDE no longer declares -->
  <module value="com.intellij.java"/>
  <module value="com.intellij.modules.java-capable"/>

  <content namespace="jetbrains">
    <module name="intellij.java.syntax" loading="embedded"/>
    <module name="intellij.java.frontback.psi" loading="embedded"/>
    <module name="intellij.java.frontback.psi.impl" loading="embedded"/>
    <module name="intellij.java.psi" loading="embedded"/>
    <module name="intellij.java.psi.impl" loading="embedded"/>
    <module name="intellij.java.frontback.impl" loading="embedded"/>

    <module name="intellij.java.indexing" required-if-available="intellij.platform.backend"/>
    <module name="intellij.platform.uast" required-if-available="intellij.platform.backend"/>
    <module name="intellij.platform.uast.ide" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.uast" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.compiler" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.analysis" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.execution" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.remoteServers" loading="optional"/>
    <module name="intellij.jvm.analysis" required-if-available="intellij.platform.backend"/>
    <module name="intellij.jsp" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.debugger" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.codeserver.core" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.codeserver.highlighting" required-if-available="intellij.platform.backend"/>

    <module name="intellij.jsp.spi" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.indexing.impl" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.analysis.impl" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.structureView" required-if-available="intellij.platform.backend"/>

    <module name="intellij.java.impl" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.xml.dom.impl"/>
    <module name="intellij.java.bookmarks" loading="optional"/>
    <module name="intellij.java.impl.refactorings" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.compiler.impl" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.typeMigration" required-if-available="intellij.platform.backend"/>
    <module name="intellij.java.impl.inspections" required-if-available="intellij.platform.backend"/>
    <module name="intellij.jvm.analysis.refactoring" required-if-available="intellij.platform.backend"/>
